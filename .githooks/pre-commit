#!/usr/bin/env bash
# pre-commit — block committing local context and secrets. Fail-closed.
set -euo pipefail
staged=$(git diff --cached --name-only)
fail=0
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
    _meta/*)            echo "✗ BLOCKED: $f — _meta/ is local-only and never committed."; fail=1 ;;
    .env|.env.*|*.pem)  echo "✗ BLOCKED: $f — secrets never enter git."; fail=1 ;;
    corpus/local/*)     echo "✗ BLOCKED: $f — uncleared corpus documents stay local."; fail=1 ;;
  esac
done <<< "$staged"
# secret-shaped strings in staged content (added lines only)
if git diff --cached -U0 | grep -E '^\+' | grep -qE 'sk-ant-[A-Za-z0-9_-]{10,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----'; then
  echo "✗ BLOCKED: staged content contains a secret-shaped string."; fail=1
fi
exit $fail
